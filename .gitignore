# Dependencies
node_modules/

# Frontend builds
dist/
build/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Test coverage
.coverage
coverage.xml
htmlcov/

# Local databases
*.db
*.db-journal
*.sqlite3

# Environment and secrets
.env
.env.*
!.env.example

# IDE and OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs and temporary files
*.log
*.tmp
*.pid

# Local uploads and backups.
# The uploads directory is tracked only through its .gitkeep; a parent-level
# `uploads/` rule would make that re-inclusion impossible, so it is not used.
backend/data/uploads/*
!backend/data/uploads/.gitkeep
backups/
