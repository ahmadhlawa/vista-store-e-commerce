# Backend environment. Copy to backend/.env — never commit the real file.

APP_ENV=development
APP_NAME=Vista Store
API_V1_PREFIX=/api/v1

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-secure-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Local development and tests use SQLite; no database server is required.
# A Vista-specific file, so this instance never shares the template's dev database.
DATABASE_URL=sqlite+pysqlite:///./data/vista_store_dev.db
# Future MySQL 8 deployment (one database and one user per client instance):
# DATABASE_URL=mysql+pymysql://commerce_user:replace-password@127.0.0.1:3306/commerce_database

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Media stays on local disk for this client. R2 is out of scope here.
STORAGE_PROVIDER=local
# Vista's own upload directory, ignored by Git. Runtime uploads never mix with the
# tracked seed/brand assets in backend/data/brand.
LOCAL_MEDIA_ROOT=./data/vista-uploads
LOCAL_MEDIA_BASE_URL=/media
MAX_UPLOAD_SIZE_BYTES=5242880

# Cloudflare R2 — adapter present but not activated; leave empty for local storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# Only read by `python -m app.initial_data` and `python -m scripts.seed`.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=Store Owner
