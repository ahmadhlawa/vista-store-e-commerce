# Instance identity
CLIENT_SLUG=example-client
STORE_NAME=Example Store
APP_ENV=development

# Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
SECRET_KEY=replace-with-a-secure-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database
DATABASE_URL=mysql+pymysql://example_user:replace-password@127.0.0.1:3306/example_database

# Frontend
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Object storage
OBJECT_STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
